# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client-side Anon Public Key (starts with sb_publishable_... or eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-side Service Role Secret Key (REQUIRED for Admin actions & bypassing RLS, starts with sb_secret_... or eyJ...)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
NEXT_PUBLIC_SITE_URL=https://vietnam-nihongo-guide.com

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com
